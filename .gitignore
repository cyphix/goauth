# Project Ignores

# Cursor
*.log
.cursor/settings.json

# pnpm store (local cache when install runs from monorepo root)
.pnpm-store/

# IDE Ignores
**/.idea/
**/.vscode/



# Binaries for programs and plugins
**/bin/
tmp/

*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local uploaded media (dev)
data/media/
